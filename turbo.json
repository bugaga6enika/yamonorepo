{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "DATABASE_URL",
    "OIDC_ISSUER_URL",
    "OIDC_COOKIE_KEYS",
    "OIDC_CLIENT_WEB_ID",
    "OIDC_CLIENT_WEB_SECRET",
    "OIDC_CLIENT_WEB_REDIRECT_URI",
    "OIDC_CLIENT_SWAGGER_ID",
    "OIDC_CLIENT_SWAGGER_SECRET",
    "OIDC_CLIENT_SWAGGER_REDIRECT_URI",
    "SEED_ADMIN_LOGIN",
    "SEED_ADMIN_PASSWORD",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_NAME",
    "APP_URL",
    "OIDC_CLIENT_ID",
    "OIDC_CLIENT_SECRET",
    "AUTH_SESSION_SECRET",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test", "@repo/vitest-config#build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
