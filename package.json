{
  "name": "yamonorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch"
  },
  "devDependencies": {
    "@repo/vitest-config": "*",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
